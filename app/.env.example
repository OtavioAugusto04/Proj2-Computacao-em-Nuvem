PORT=3000
HOST=127.0.0.1
DB_HOST=localhost
DB_USER=envweb
DB_PASS=troque_no_provision
DB_NAME=envs
ENVCTL_PATH=/usr/local/bin/envctl
ENVCTL_SUDO=true
SCRIPTS_DIR=/var/lib/envs/scripts

